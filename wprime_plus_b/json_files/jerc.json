{
  "_comment": {
    "description": "Jet energy correction algorithms per data-taking era",
    "note": "Each era lists the sequential JEC levels applied",
    "reference_1": "https://cms-jerc.web.cern.ch/JEC/#factorized-approach",
    "reference_2": "https://twiki.cern.ch/twiki/bin/view/CMS/JetMET#Quick_links_to_current_recommend",
    "types": {
        "L1": "remove the energy coming from pile-up events. Run 3 uses PUPPI jets, so it is not needed these corrections",
        "L2": "Calibrates jet response vs. η so jets have uniform response across the detector",
        "L2L3": "Residual corrections applied only to real data to fix small data/MC differences"
    }
  },
